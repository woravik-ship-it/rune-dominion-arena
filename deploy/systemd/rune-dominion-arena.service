[Unit]
Description=Rune Dominion Arena — Next.js production server (port 3000)
Documentation=file:/home/woravik/E2_Lab/Game_Card/rune-dominion-arena/docs/DEPLOYMENT.md
After=network.target rune-dominion-postgres.service
Wants=rune-dominion-postgres.service
# 2026-10-07: ตัด PartOf=rune-dominion-tunnel.service ออก — quick tunnel ถูกยกเลิกแล้ว
# (เปลี่ยนไปใช้ Cloudflare named tunnel `e2sv` → dash.e2sv.link) ถ้ายังผูกอยู่
# การ stop tunnel จะลาก service นี้ดับตาม ทำให้ rune.e2sv.link กลายเป็น 502

[Service]
Type=simple
WorkingDirectory=/home/woravik/E2_Lab/Game_Card/rune-dominion-arena
# .env ของโปรเจกต์ (DATABASE_URL / AUTH_SECRET / SERVER_PEPPER ...)
EnvironmentFile=/home/woravik/E2_Lab/Game_Card/rune-dominion-arena/.env
# ค่าที่ต้องทับ .env ตอนรันจริง (บรรทัดหลังสุดชนะ)
Environment=NODE_ENV=production
Environment=PORT=3000
Environment=LOG_LEVEL=info
Environment=SLOW_REQUEST_MS=500
Environment=APP_VERSION=beta
# ผูกกับทุก interface เพราะหน้าเว็บถูกใช้ทั้งในวง LAN และผ่าน tunnel
ExecStart=/usr/bin/node /home/woravik/E2_Lab/Game_Card/rune-dominion-arena/node_modules/next/dist/bin/next start --port 3000 --hostname 0.0.0.0
Restart=always
RestartSec=5
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=default.target
