// Rune Dominion Arena - Prisma Schema
// Phase 1: Card Discovery

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ===== AUTH =====

model User {
  id            String    @id @default(cuid())
  email         String    @unique
  username      String    @unique
  passwordHash  String
  displayName   String?
  avatarUrl     String?
  role          UserRole  @default(PLAYER)
  isActive      Boolean   @default(true)
  discoveryEnergy Int     @default(5) @map("discovery_energy")
  lastEnergyResetAt DateTime? @map("last_energy_reset_at")
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  // Relations
  wallet        Wallet?
  cards         UserCard[]
  decks         Deck[]
  discoveries   DiscoveryLog[]
  attackerBattles BattleLog[] @relation("BattleAttacker")
  defenderBattles BattleLog[] @relation("BattleDefender")
  quests       QuestProgress[]
  arenaRooms    ArenaRoom[]
  arenaParticipations ArenaParticipant[]
  eventParticipations EventParticipation[]
  discoveredCards CardDefinition[] @relation("FirstDiscoverer")

  @@map("users")
}

enum UserRole {
  PLAYER
  ADMIN
  MODERATOR
}

// ===== CARD SYSTEM =====

model CardDefinition {
  id              String   @id @default(cuid())
  canonicalSeedHash String @unique @map("canonical_seed_hash")
  name            String
  nameTh          String?  @map("name_th")
  description     String?
  descriptionTh   String?  @map("description_th")
  lore            String?
  loreTh          String?  @map("lore_th")
  
  // Stats
  element         Element
  rarity          Rarity
  role            CardRole
  atk             Int
  def             Int
  hp              Int
  spd             Int
  manaCost        Int      @map("mana_cost")
  
  // Skills
  skill1Name      String?  @map("skill1_name")
  skill1Desc      String?  @map("skill1_desc")
  skill1ManaCost  Int?     @map("skill1_mana_cost")
  skill2Name      String?  @map("skill2_name")
  skill2Desc      String?  @map("skill2_desc")
  skill2ManaCost  Int?     @map("skill2_mana_cost")
  
  // Media
  imageUrl        String?  @map("image_url")
  imageStatus     ImageStatus @default(PENDING) @map("image_status")
  thumbnailUrl    String?  @map("thumbnail_url")
  
  // Metadata
  discoveryCount  Int      @default(0) @map("discovery_count")
  firstDiscovererId String? @map("first_discoverer_id")
  firstDiscoveredAt DateTime? @map("first_discovered_at")
  createdAt       DateTime @default(now())
  updatedAt       DateTime  @updatedAt

  // Relations
  userCards       UserCard[]
  discoveries     DiscoveryLog[]
  deckSlots       DeckSlot[]
  imageJobs       ImageJob[]
  firstDiscoverer User?     @relation("FirstDiscoverer", fields: [firstDiscovererId], references: [id])

  @@index([element])
  @@index([rarity])
  @@index([imageStatus])
  @@map("card_definitions")
}

enum Element {
  EMBERBOUND
  TIDEBORN
  SKYRIVEN
  ROOTFORGED
  DAWNSWORN
  VEILMARKED
}

enum Rarity {
  COMMON
  UNCOMMON
  RARE
  EPIC
  LEGENDARY
  MYTHIC
}

enum CardRole {
  WARRIOR
  MAGE
  HEALER
  TANK
  ASSASSIN
  SUPPORT
}

enum ImageStatus {
  PENDING
  PROCESSING
  READY
  FAILED
}

model UserCard {
  id              String   @id @default(cuid())
  userId          String   @map("user_id")
  cardId          String   @map("card_id")
  isFavorite      Boolean  @default(false) @map("is_favorite")
  obtainedMethod  String   @map("obtained_method")
  obtainedAt      DateTime @default(now()) @map("obtained_at")
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  // Relations
  user            User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  card            CardDefinition @relation(fields: [cardId], references: [id], onDelete: Cascade)

  @@unique([userId, cardId])
  @@index([userId])
  @@index([cardId])
  @@map("user_cards")
}

model DiscoveryLog {
  id              String   @id @default(cuid())
  userId          String   @map("user_id")
  cardId          String   @map("card_id")
  runeSequence    String   @map("rune_sequence")
  canonicalString String   @map("canonical_string")
  seedHash        String   @map("seed_hash")
  isFirstDiscovery Boolean @map("is_first_discovery")
  idempotencyKey  String?  @unique @map("idempotency_key")
  createdAt       DateTime @default(now())

  // Relations
  user            User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  card            CardDefinition @relation(fields: [cardId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([seedHash])
  @@map("discovery_logs")
}

// ===== WALLET =====

model Wallet {
  id              String   @id @default(cuid())
  userId          String   @unique @map("user_id")
  balance         Int      @default(0)
  totalEarned     Int      @default(0) @map("total_earned")
  totalSpent      Int      @default(0) @map("total_spent")
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  // Relations
  user            User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  transactions    WalletTransaction[]

  @@map("wallets")
}

model WalletTransaction {
  id              String   @id @default(cuid())
  walletId        String   @map("wallet_id")
  amount          Int
  type            TransactionType
  referenceId     String?  @map("reference_id")
  referenceType   String?  @map("reference_type")
  description     String?
  balanceBefore   Int      @map("balance_before")
  balanceAfter    Int      @map("balance_after")
  idempotencyKey  String?  @unique @map("idempotency_key")
  createdAt       DateTime @default(now())

  // Relations
  wallet          Wallet   @relation(fields: [walletId], references: [id], onDelete: Cascade)

  @@index([walletId])
  @@index([type])
  @@index([createdAt])
  @@map("wallet_transactions")
}

enum TransactionType {
  EARN
  SPEND
  REWARD
  PURCHASE
}

// ===== DECK =====

model Deck {
  id              String   @id @default(cuid())
  userId          String   @map("user_id")
  name            String
  description     String?
  isActive        Boolean  @default(true)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  // Relations
  user            User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  slots           DeckSlot[]

  @@index([userId])
  @@map("decks")
}

model DeckSlot {
  id              String   @id @default(cuid())
  deckId          String   @map("deck_id")
  cardId          String   @map("card_id")
  position        Int
  createdAt       DateTime @default(now())

  // Relations
  deck            Deck     @relation(fields: [deckId], references: [id], onDelete: Cascade)
  card            CardDefinition @relation(fields: [cardId], references: [id], onDelete: Cascade)

  @@unique([deckId, cardId])
  @@index([deckId])
  @@map("deck_slots")
}

// ===== BATTLE =====

model BattleLog {
  id              String   @id @default(cuid())
  attackerId      String   @map("attacker_id")
  defenderId      String   @map("defender_id")
  attackerDeckId  String?  @map("attacker_deck_id")
  defenderDeckId  String?  @map("defender_deck_id")
  winnerId        String?  @map("winner_id")
  battleData      Json     @map("battle_data")
  rewardAmount    Int      @default(0) @map("reward_amount")
  createdAt       DateTime @default(now())

  // Relations
  attacker        User     @relation("BattleAttacker", fields: [attackerId], references: [id])
  defender        User     @relation("BattleDefender", fields: [defenderId], references: [id])

  @@index([attackerId])
  @@index([defenderId])
  @@map("battle_logs")
}

// ===== ARENA =====

model ArenaRoom {
  id              String   @id @default(cuid())
  hostId          String   @map("host_id")
  name            String
  status          ArenaStatus @default(WAITING)
  maxPlayers      Int      @default(8) @map("max_players")
  currentRound    Int      @default(0) @map("current_round")
  startedAt       DateTime? @map("started_at")
  endedAt         DateTime? @map("ended_at")
  // Phase 6: วงจร 24 ชม. + แชมป์ + รางวัล
  entryFee        Int      @default(10) @map("entry_fee")
  rewardPool      Int      @default(100) @map("reward_pool")
  championId      String?  @map("champion_id")
  championDeckId  String?  @map("champion_deck_id")
  expiresAt       DateTime? @map("expires_at")
  settledAt       DateTime? @map("settled_at")
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  // Relations
  host            User     @relation(fields: [hostId], references: [id])
  participants    ArenaParticipant[]
  challenges      ArenaChallenge[]

  @@index([status])
  @@index([expiresAt])
  @@map("arena_rooms")
}

enum ArenaStatus {
  WAITING
  ACTIVE
  EXPIRED
  SETTLING
  SETTLED
  IN_PROGRESS
  COMPLETED
  CANCELLED
}

model ArenaParticipant {
  id              String   @id @default(cuid())
  roomId          String   @map("room_id")
  userId          String   @map("user_id")
  deckId          String?  @map("deck_id")
  placement       Int?
  prizeAmount     Int      @default(0) @map("prize_amount")
  wins            Int      @default(0)
  losses          Int      @default(0)
  joinedAt        DateTime @default(now()) @map("joined_at")

  // Relations
  room            ArenaRoom @relation(fields: [roomId], references: [id], onDelete: Cascade)
  user            User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([roomId, userId])
  @@index([roomId])
  @@map("arena_participants")
}

model ArenaChallenge {
  id              String   @id @default(cuid())
  roomId          String   @map("room_id")
  challengerId    String   @map("challenger_id")
  challengerDeckId String  @map("challenger_deck_id")
  defenderId      String   @map("defender_id")
  defenderDeckId  String   @map("defender_deck_id")
  winnerId        String?  @map("winner_id")
  battleLogId     String?  @map("battle_log_id")
  idempotencyKey  String?  @unique @map("idempotency_key")
  createdAt       DateTime @default(now())

  // Relations
  room            ArenaRoom @relation(fields: [roomId], references: [id], onDelete: Cascade)

  @@index([roomId])
  @@index([challengerId])
  @@map("arena_challenges")
}

// ===== QUESTS =====

model Quest {
  id              String   @id @default(cuid())
  code            String   @unique
  name            String
  nameTh          String   @map("name_th")
  description     String?
  descriptionTh   String?  @map("description_th")
  type            QuestType
  metric          QuestMetric
  targetValue     Int      @map("target_value")
  rewardAmount    Int      @map("reward_amount")
  isActive        Boolean  @default(true)
  startDate       DateTime? @map("start_date")
  endDate         DateTime? @map("end_date")
  createdAt       DateTime @default(now())

  // Relations
  progress        QuestProgress[]

  @@index([type])
  @@index([isActive])
  @@map("quests")
}

enum QuestType {
  DAILY
  WEEKLY
  ACHIEVEMENT
  EVENT
}

// เหตุการณ์ที่ใช้นับความคืบหน้าของเควส (hook จากระบบอื่น)
enum QuestMetric {
  DISCOVERY
  BATTLE
  BATTLE_WIN
  ARENA_WIN
  SPEND
}

model QuestProgress {
  id              String   @id @default(cuid())
  questId         String   @map("quest_id")
  userId          String   @map("user_id")
  // คีย์ของงวด เช่น "2025-09-13" (รายวัน) / "2025-W37" (รายสัปดาห์) / "ALL" (ถาวร)
  periodKey       String   @map("period_key")
  currentValue    Int      @default(0) @map("current_value")
  isCompleted     Boolean  @default(false) @map("is_completed")
  completedAt     DateTime? @map("completed_at")
  rewardClaimed   Boolean  @default(false) @map("reward_claimed")
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  // Relations
  quest           Quest    @relation(fields: [questId], references: [id], onDelete: Cascade)
  user            User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([questId, userId, periodKey])
  @@index([userId, periodKey])
  @@map("quest_progress")
}

// ===== IMAGE JOBS =====

model ImageJob {
  id              String   @id @default(cuid())
  cardId          String   @map("card_id")
  status          ImageJobStatus @default(PENDING)
  priority        Int      @default(0)
  retryCount      Int      @default(0) @map("retry_count")
  maxRetries      Int      @default(3) @map("max_retries")
  imagePrompt     String?  @map("image_prompt")
  errorMessage    String?  @map("error_message")
  resultUrl       String?  @map("result_url")
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
  processedAt     DateTime? @map("processed_at")

  // Relations
  card            CardDefinition @relation(fields: [cardId], references: [id], onDelete: Cascade)

  @@index([status])
  @@index([priority])
  @@map("image_jobs")
}

enum ImageJobStatus {
  PENDING
  PROCESSING
  COMPLETED
  FAILED
}

// ===== EVENTS =====

model Event {
  id              String   @id @default(cuid())
  name            String
  nameTh          String   @map("name_th")
  description     String?
  descriptionTh   String?  @map("description_th")
  eventType       EventType @map("event_type")
  status          EventStatus @default(UPCOMING)
  startDate       DateTime @map("start_date")
  endDate         DateTime @map("end_date")
  gracePeriodEnd  DateTime? @map("grace_period_end")
  currencyName    String   @map("currency_name")
  maxCurrency     Int?     @map("max_currency")
  isActive        Boolean  @default(true)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  // Relations
  quests          EventQuest[]
  participations  EventParticipation[]

  @@index([status])
  @@index([startDate])
  @@map("events")
}

enum EventType {
  SEASONAL
  WEEKLY
  SPECIAL
  COMMUNITY
}

enum EventStatus {
  UPCOMING
  ACTIVE
  GRACE_PERIOD
  ENDED
}

model EventQuest {
  id              String   @id @default(cuid())
  eventId         String   @map("event_id")
  name            String
  nameTh          String   @map("name_th")
  description     String?
  descriptionTh   String?  @map("description_th")
  type            EventQuestType
  targetValue     Int      @map("target_value")
  rewardAmount    Int      @map("reward_amount")
  currencyReward  Int      @default(0) @map("currency_reward")
  isActive        Boolean  @default(true)
  createdAt       DateTime @default(now())

  // Relations
  event           Event    @relation(fields: [eventId], references: [id], onDelete: Cascade)

  @@index([eventId])
  @@map("event_quests")
}

enum EventQuestType {
  DAILY
  WEEKLY
  MILESTONE
  COMMUNITY
}

model EventParticipation {
  id              String   @id @default(cuid())
  eventId         String   @map("event_id")
  userId          String   @map("user_id")
  currencyEarned  Int      @default(0) @map("currency_earned")
  currencySpent   Int      @default(0) @map("currency_spent")
  milestonesReached String[] @map("milestones_reached")
  rewardsClaimed  Json?    @map("rewards_claimed")
  joinedAt        DateTime @default(now())
  updatedAt       DateTime @updatedAt

  // Relations
  event           Event    @relation(fields: [eventId], references: [id], onDelete: Cascade)
  user            User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([eventId, userId])
  @@index([eventId])
  @@index([userId])
  @@map("event_participations")
}
