// Rune Dominion Arena - Prisma Schema
// Phase 1: Card Discovery

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ===== AUTH =====

// ===== ADMIN =====

model AdminActionLog {
  id            String   @id @default(cuid())
  adminId       String   @map("admin_id")
  adminUsername String   @map("admin_username")
  action        String // เช่น UPDATE_CARD, TOGGLE_QUEST, REQUEUE_IMAGES
  targetType    String   @map("target_type") // CARD / QUEST / USER / IMAGE / SYSTEM
  targetId      String?  @map("target_id")
  detail        Json?
  createdAt     DateTime @default(now()) @map("created_at")

  @@index([createdAt])
  @@index([adminId])
  @@map("admin_action_logs")
}

// ===== SECURITY (Phase 10) =====

// เหตุการณ์ความปลอดภัย — Rate limit, Bot pattern, Alt-account, Replay tamper
model SecurityEvent {
  id        String   @id @default(cuid())
  type      String // RATE_LIMIT_BLOCKED / BOT_PATTERN / ALT_ACCOUNT_SUSPECT / REPLAY_TAMPERED / AUTH_FAILURE_SPIKE / CORS_BLOCKED
  severity  String // LOW / MEDIUM / HIGH
  userId    String?  @map("user_id")
  ip        String?
  deviceId  String?  @map("device_id")
  detail    Json?
  createdAt DateTime @default(now()) @map("created_at")

  @@index([type])
  @@index([userId])
  @@index([createdAt])
  @@map("security_events")
}

// ===== AUTH / USER =====

model User {
  id                String    @id @default(cuid())
  email             String    @unique
  username          String    @unique
  passwordHash      String
  displayName       String?
  avatarUrl         String?
  role              UserRole  @default(PLAYER)
  isActive          Boolean   @default(true)
  discoveryEnergy   Int       @default(5) @map("discovery_energy")
  lastEnergyResetAt DateTime? @map("last_energy_reset_at")

  // Phase 25: Veil Shards = สกุลเงินกลางของ "ร้านช่าง/กิจกรรม" (ได้จากการขายการ์ดคืนร้าน + กิจกรรม)
  veilShards Int @default(0) @map("veil_shards")

  // Phase 26: อวตารในเกม — เลือกอิโมจิ หรือวาดเองในช่อง 6×6
  // avatarGrid = รหัส 36 ตัวอักษร (6 แถว × 6 ช่อง) · '.' = โปร่งใส · ตัวอักษรอื่น = สีในพาเลตต์ (ดู src/lib/avatar.ts)
  avatarEmoji String? @map("avatar_emoji")
  avatarGrid  String? @map("avatar_grid")

  // Phase 20: ภาษาในเกม (th/en) + ค่าที่ผู้เล่นเลือกสำหรับการแจ้งเตือน
  // notifyPrefs = { image: boolean, battle: boolean, arena: boolean, event: boolean, announcement: boolean }
  locale      String @default("th") @map("locale")
  notifyPrefs Json?  @map("notify_prefs")

  // Phase 10: fingerprint สำหรับตรวจ Alt-account (device id + IP)
  signupDeviceId String? @map("signup_device_id")
  lastDeviceId   String? @map("last_device_id")
  signupIp       String? @map("signup_ip")
  lastIp         String? @map("last_ip")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Relations
  wallet              Wallet?
  cards               UserCard[]
  decks               Deck[]
  discoveries         DiscoveryLog[]
  attackerBattles     BattleLog[]            @relation("BattleAttacker")
  defenderBattles     BattleLog[]            @relation("BattleDefender")
  quests              QuestProgress[]
  arenaRooms          ArenaRoom[]
  arenaParticipations ArenaParticipant[]
  eventParticipations EventParticipation[]
  eventRaids          EventRaidAttempt[]
  eventPurchases      EventShopPurchase[]
  eventQuestProgress  EventQuestProgress[]
  inventory           UserInventoryItem[]
  discoveredCards     CardDefinition[]       @relation("FirstDiscoverer")
  notifications       Notification[]
  // Phase 25: ไอเทมที่ถือ + ประวัติการได้/ใช้ Veil Shards
  items               UserItem[]
  veilShardTx         VeilShardTransaction[]
  // Phase 31: ดันเจี้ยน (ความคืบหน้า + ประวัติการลุย)
  dungeonProgress     DungeonProgress[]
  dungeonRuns         DungeonRun[]

  // Phase 12: index สำหรับ fingerprint lookup (ทุกครั้งที่สมัคร/ล็อกอิน) + admin filter
  @@index([signupDeviceId])
  @@index([lastDeviceId])
  @@index([role])
  @@map("users")
}

enum UserRole {
  PLAYER
  ADMIN
  MODERATOR
}

// ===== CARD SYSTEM =====

model CardDefinition {
  id                String  @id @default(cuid())
  canonicalSeedHash String  @unique @map("canonical_seed_hash")
  name              String
  nameTh            String? @map("name_th")
  description       String?
  descriptionTh     String? @map("description_th")
  lore              String?
  loreTh            String? @map("lore_th")

  // Stats
  element  Element
  rarity   Rarity
  role     CardRole
  atk      Int
  def      Int
  hp       Int
  spd      Int
  manaCost Int      @map("mana_cost")

  // Skills
  skill1Name     String? @map("skill1_name")
  skill1Desc     String? @map("skill1_desc")
  skill1ManaCost Int?    @map("skill1_mana_cost")
  skill2Name     String? @map("skill2_name")
  skill2Desc     String? @map("skill2_desc")
  skill2ManaCost Int?    @map("skill2_mana_cost")

  // Media
  imageUrl     String?     @map("image_url")
  imageStatus  ImageStatus @default(PENDING) @map("image_status")
  thumbnailUrl String?     @map("thumbnail_url")

  // Metadata
  discoveryCount    Int       @default(0) @map("discovery_count")
  firstDiscovererId String?   @map("first_discoverer_id")
  firstDiscoveredAt DateTime? @map("first_discovered_at")
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  // Relations
  userCards       UserCard[]
  discoveries     DiscoveryLog[]
  deckSlots       DeckSlot[]
  imageJobs       ImageJob[]
  firstDiscoverer User?          @relation("FirstDiscoverer", fields: [firstDiscovererId], references: [id])

  @@index([element])
  @@index([rarity])
  @@index([imageStatus])
  @@map("card_definitions")
}

enum Element {
  EMBERBOUND
  TIDEBORN
  SKYRIVEN
  ROOTFORGED
  DAWNSWORN
  VEILMARKED
}

enum Rarity {
  COMMON
  UNCOMMON
  RARE
  EPIC
  LEGENDARY
  MYTHIC
}

enum CardRole {
  WARRIOR
  MAGE
  HEALER
  TANK
  ASSASSIN
  SUPPORT
}

enum ImageStatus {
  PENDING
  PROCESSING
  READY
  FAILED
}

model UserCard {
  id             String   @id @default(cuid())
  userId         String   @map("user_id")
  cardId         String   @map("card_id")
  isFavorite     Boolean  @default(false) @map("is_favorite")
  obtainedMethod String   @map("obtained_method")
  // จำนวนใบที่ถือครอง — ค้นพบใบซ้ำจะได้อีกใบ (x2, x3, ...)
  quantity       Int      @default(1) @map("quantity")
  obtainedAt     DateTime @default(now()) @map("obtained_at")
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  // Relations
  user User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  card CardDefinition @relation(fields: [cardId], references: [id], onDelete: Cascade)

  // Phase 25: ช่องใส่ Item ของการ์ดใบนี้ (โจมตี/ป้องกัน/สนับสนุน — อย่างละ 1 ชิ้น)
  itemSlots CardItemSlot[]

  @@unique([userId, cardId])
  @@index([userId])
  @@index([cardId])
  @@map("user_cards")
}

model DiscoveryLog {
  id               String   @id @default(cuid())
  userId           String   @map("user_id")
  cardId           String   @map("card_id")
  runeSequence     String   @map("rune_sequence")
  canonicalString  String   @map("canonical_string")
  seedHash         String   @map("seed_hash")
  isFirstDiscovery Boolean  @map("is_first_discovery")
  idempotencyKey   String?  @unique @map("idempotency_key")
  createdAt        DateTime @default(now())

  // Relations
  user User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  card CardDefinition @relation(fields: [cardId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([seedHash])
  @@map("discovery_logs")
}

// ===== WALLET =====

model Wallet {
  id          String   @id @default(cuid())
  userId      String   @unique @map("user_id")
  balance     Int      @default(0)
  totalEarned Int      @default(0) @map("total_earned")
  totalSpent  Int      @default(0) @map("total_spent")
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  // Relations
  user         User                @relation(fields: [userId], references: [id], onDelete: Cascade)
  transactions WalletTransaction[]

  @@map("wallets")
}

model WalletTransaction {
  id             String          @id @default(cuid())
  walletId       String          @map("wallet_id")
  amount         Int
  type           TransactionType
  referenceId    String?         @map("reference_id")
  referenceType  String?         @map("reference_type")
  description    String?
  balanceBefore  Int             @map("balance_before")
  balanceAfter   Int             @map("balance_after")
  idempotencyKey String?         @unique @map("idempotency_key")
  createdAt      DateTime        @default(now())

  // Relations
  wallet Wallet @relation(fields: [walletId], references: [id], onDelete: Cascade)

  @@index([walletId])
  @@index([type])
  @@index([createdAt])
  @@map("wallet_transactions")
}

enum TransactionType {
  EARN
  SPEND
  REWARD
  PURCHASE
}

// ===== DECK =====

model Deck {
  id          String   @id @default(cuid())
  userId      String   @map("user_id")
  name        String
  description String?
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  // Relations
  user  User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  slots DeckSlot[]

  @@index([userId])
  @@map("decks")
}

model DeckSlot {
  id        String   @id @default(cuid())
  deckId    String   @map("deck_id")
  cardId    String   @map("card_id")
  position  Int
  createdAt DateTime @default(now())

  // Relations
  deck Deck           @relation(fields: [deckId], references: [id], onDelete: Cascade)
  card CardDefinition @relation(fields: [cardId], references: [id], onDelete: Cascade)

  @@unique([deckId, cardId])
  @@index([deckId])
  @@map("deck_slots")
}

// ===== BATTLE =====

model BattleLog {
  id             String   @id @default(cuid())
  attackerId     String   @map("attacker_id")
  defenderId     String   @map("defender_id")
  attackerDeckId String?  @map("attacker_deck_id")
  defenderDeckId String?  @map("defender_deck_id")
  winnerId       String?  @map("winner_id")
  battleData     Json     @map("battle_data")
  rewardAmount   Int      @default(0) @map("reward_amount")
  createdAt      DateTime @default(now())

  // Relations
  attacker User @relation("BattleAttacker", fields: [attackerId], references: [id])
  defender User @relation("BattleDefender", fields: [defenderId], references: [id])

  @@index([attackerId])
  @@index([defenderId])
  @@map("battle_logs")
}

// ===== ARENA =====

model ArenaRoom {
  id             String      @id @default(cuid())
  hostId         String      @map("host_id")
  name           String
  status         ArenaStatus @default(WAITING)
  maxPlayers     Int         @default(8) @map("max_players")
  currentRound   Int         @default(0) @map("current_round")
  startedAt      DateTime?   @map("started_at")
  endedAt        DateTime?   @map("ended_at")
  // Phase 6: วงจร 24 ชม. + แชมป์ + รางวัล
  entryFee       Int         @default(10) @map("entry_fee")
  rewardPool     Int         @default(100) @map("reward_pool")
  championId     String?     @map("champion_id")
  championDeckId String?     @map("champion_deck_id")
  expiresAt      DateTime?   @map("expires_at")
  settledAt      DateTime?   @map("settled_at")
  createdAt      DateTime    @default(now())
  updatedAt      DateTime    @updatedAt

  // Relations
  host         User               @relation(fields: [hostId], references: [id])
  participants ArenaParticipant[]
  challenges   ArenaChallenge[]

  @@index([status])
  @@index([expiresAt])
  @@map("arena_rooms")
}

enum ArenaStatus {
  WAITING
  ACTIVE
  EXPIRED
  SETTLING
  SETTLED
  IN_PROGRESS
  COMPLETED
  CANCELLED
}

model ArenaParticipant {
  id          String   @id @default(cuid())
  roomId      String   @map("room_id")
  userId      String   @map("user_id")
  deckId      String?  @map("deck_id")
  placement   Int?
  prizeAmount Int      @default(0) @map("prize_amount")
  wins        Int      @default(0)
  losses      Int      @default(0)
  joinedAt    DateTime @default(now()) @map("joined_at")

  // Relations
  room ArenaRoom @relation(fields: [roomId], references: [id], onDelete: Cascade)
  user User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([roomId, userId])
  @@index([roomId])
  @@map("arena_participants")
}

model ArenaChallenge {
  id               String   @id @default(cuid())
  roomId           String   @map("room_id")
  challengerId     String   @map("challenger_id")
  challengerDeckId String   @map("challenger_deck_id")
  defenderId       String   @map("defender_id")
  defenderDeckId   String   @map("defender_deck_id")
  winnerId         String?  @map("winner_id")
  battleLogId      String?  @map("battle_log_id")
  idempotencyKey   String?  @unique @map("idempotency_key")
  createdAt        DateTime @default(now())

  // Relations
  room ArenaRoom @relation(fields: [roomId], references: [id], onDelete: Cascade)

  @@index([roomId])
  @@index([challengerId])
  @@map("arena_challenges")
}

// ===== QUESTS =====

model Quest {
  id            String      @id @default(cuid())
  code          String      @unique
  name          String
  nameTh        String      @map("name_th")
  description   String?
  descriptionTh String?     @map("description_th")
  type          QuestType
  metric        QuestMetric
  targetValue   Int         @map("target_value")
  rewardAmount  Int         @map("reward_amount")
  isActive      Boolean     @default(true)
  startDate     DateTime?   @map("start_date")
  endDate       DateTime?   @map("end_date")
  createdAt     DateTime    @default(now())

  // Relations
  progress QuestProgress[]

  @@index([type])
  @@index([isActive])
  @@map("quests")
}

enum QuestType {
  DAILY
  WEEKLY
  ACHIEVEMENT
  EVENT
}

// เหตุการณ์ที่ใช้นับความคืบหน้าของเควส (hook จากระบบอื่น)
enum QuestMetric {
  DISCOVERY
  BATTLE
  BATTLE_WIN
  ARENA_WIN
  SPEND
}

model QuestProgress {
  id            String    @id @default(cuid())
  questId       String    @map("quest_id")
  userId        String    @map("user_id")
  // คีย์ของงวด เช่น "2025-09-13" (รายวัน) / "2025-W37" (รายสัปดาห์) / "ALL" (ถาวร)
  periodKey     String    @map("period_key")
  currentValue  Int       @default(0) @map("current_value")
  isCompleted   Boolean   @default(false) @map("is_completed")
  completedAt   DateTime? @map("completed_at")
  rewardClaimed Boolean   @default(false) @map("reward_claimed")
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  // Relations
  quest Quest @relation(fields: [questId], references: [id], onDelete: Cascade)
  user  User  @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([questId, userId, periodKey])
  @@index([userId, periodKey])
  @@map("quest_progress")
}

// ===== IMAGE JOBS =====

model ImageJob {
  id           String         @id @default(cuid())
  cardId       String         @map("card_id")
  status       ImageJobStatus @default(PENDING)
  priority     Int            @default(0)
  retryCount   Int            @default(0) @map("retry_count")
  maxRetries   Int            @default(3) @map("max_retries")
  imagePrompt  String?        @map("image_prompt")
  errorMessage String?        @map("error_message")
  resultUrl    String?        @map("result_url")
  createdAt    DateTime       @default(now())
  updatedAt    DateTime       @updatedAt
  // Phase 20: เวลาที่ worker เริ่มลงมือ (ใช้คำนวณเวลาสร้างจริง → ประมาณการรอคิวให้ผู้เล่น)
  startedAt    DateTime?      @map("started_at")
  processedAt  DateTime?      @map("processed_at")

  // Relations
  card CardDefinition @relation(fields: [cardId], references: [id], onDelete: Cascade)

  @@index([status])
  @@index([priority])
  @@map("image_jobs")
}

enum ImageJobStatus {
  PENDING
  PROCESSING
  COMPLETED
  FAILED
}

// ===== EVENTS =====

model Event {
  id             String      @id @default(cuid())
  name           String
  nameTh         String      @map("name_th")
  description    String?
  descriptionTh  String?     @map("description_th")
  eventType      EventType   @map("event_type")
  status         EventStatus @default(UPCOMING)
  startDate      DateTime    @map("start_date")
  endDate        DateTime    @map("end_date")
  gracePeriodEnd DateTime?   @map("grace_period_end")
  currencyName   String      @map("currency_name")
  maxCurrency    Int?        @map("max_currency")
  isActive       Boolean     @default(true)
  createdAt      DateTime    @default(now())
  updatedAt      DateTime    @updatedAt

  // Relations
  quests         EventQuest[]
  participations EventParticipation[]
  bosses         EventBoss[]
  raids          EventRaidAttempt[]
  milestones     EventMilestone[]
  shopItems      EventShopItem[]
  purchases      EventShopPurchase[]
  storyChapters  EventStoryChapter[]
  community      EventCommunityProgress?

  @@index([status])
  @@index([startDate])
  @@map("events")
}

enum EventType {
  SEASONAL
  WEEKLY
  SPECIAL
  COMMUNITY
}

enum EventStatus {
  UPCOMING
  ACTIVE
  GRACE_PERIOD
  ENDED
}

model EventQuest {
  id             String         @id @default(cuid())
  eventId        String         @map("event_id")
  name           String
  nameTh         String         @map("name_th")
  description    String?
  descriptionTh  String?        @map("description_th")
  type           EventQuestType
  targetValue    Int            @map("target_value")
  rewardAmount   Int            @map("reward_amount")
  currencyReward Int            @default(0) @map("currency_reward")
  isActive       Boolean        @default(true)
  createdAt      DateTime       @default(now())

  // Relations
  event    Event                @relation(fields: [eventId], references: [id], onDelete: Cascade)
  progress EventQuestProgress[]

  @@index([eventId])
  @@map("event_quests")
}

// ความคืบหน้าของ Event Quest ต่อผู้เล่นต่องวด (Phase 11.2 — hook จาก raid จริง)
model EventQuestProgress {
  id            String    @id @default(cuid())
  eventQuestId  String    @map("event_quest_id")
  userId        String    @map("user_id")
  periodKey     String    @map("period_key")
  currentValue  Int       @default(0) @map("current_value")
  isCompleted   Boolean   @default(false) @map("is_completed")
  completedAt   DateTime? @map("completed_at")
  rewardClaimed Boolean   @default(false) @map("reward_claimed")
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  // Relations
  quest EventQuest @relation(fields: [eventQuestId], references: [id], onDelete: Cascade)
  user  User       @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([eventQuestId, userId, periodKey])
  @@index([userId, periodKey])
  @@map("event_quest_progress")
}

enum EventQuestType {
  DAILY
  WEEKLY
  MILESTONE
  COMMUNITY
}

model EventParticipation {
  id                String   @id @default(cuid())
  eventId           String   @map("event_id")
  userId            String   @map("user_id")
  currencyEarned    Int      @default(0) @map("currency_earned")
  currencySpent     Int      @default(0) @map("currency_spent")
  eventPoints       Int      @default(0) @map("event_points")
  damageDealt       Int      @default(0) @map("damage_dealt")
  milestonesReached String[] @map("milestones_reached")
  rewardsClaimed    Json?    @map("rewards_claimed")
  joinedAt          DateTime @default(now())
  updatedAt         DateTime @updatedAt

  // Relations
  event Event              @relation(fields: [eventId], references: [id], onDelete: Cascade)
  user  User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  raids EventRaidAttempt[]

  @@unique([eventId, userId])
  @@index([eventId])
  @@index([userId])
  @@map("event_participations")
}

// ===== PHASE 11: SEASONAL EVENT — Call of the Moonless Gate (GDD §13) =====

// Boss Raid ประจำ event — 4 Phase ตามช่วง HP (GDD §13.3)
model EventBoss {
  id          String    @id @default(cuid())
  eventId     String    @map("event_id")
  name        String
  nameTh      String    @map("name_th")
  maxHp       Int       @map("max_hp")
  currentHp   Int       @map("current_hp")
  totalDamage Int       @default(0) @map("total_damage")
  isDefeated  Boolean   @default(false) @map("is_defeated")
  defeatedAt  DateTime? @map("defeated_at")
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  // Relations
  event    Event              @relation(fields: [eventId], references: [id], onDelete: Cascade)
  attempts EventRaidAttempt[]

  @@index([eventId])
  @@map("event_bosses")
}

// การเข้า Raid 1 ครั้ง — idempotent ด้วย idempotencyKey
model EventRaidAttempt {
  id              String   @id @default(cuid())
  eventId         String   @map("event_id")
  bossId          String   @map("boss_id")
  userId          String   @map("user_id")
  participationId String   @map("participation_id")
  deckId          String   @map("deck_id")
  idempotencyKey  String?  @unique @map("idempotency_key")
  damageDealt     Int      @default(0) @map("damage_dealt")
  eventPoints     Int      @default(0) @map("event_points")
  shardsSpent     Int      @default(0) @map("shards_spent")
  shardsEarned    Int      @default(0) @map("shards_earned")
  won             Boolean  @default(false)
  elementBonus    Boolean  @default(false) @map("element_bonus")
  bossPhaseBefore Int      @map("boss_phase_before")
  bossPhaseAfter  Int      @map("boss_phase_after")
  elementsUsed    String[] @map("elements_used")
  battleData      Json?    @map("battle_data")
  createdAt       DateTime @default(now())

  // Relations
  boss          EventBoss          @relation(fields: [bossId], references: [id], onDelete: Cascade)
  event         Event              @relation(fields: [eventId], references: [id], onDelete: Cascade)
  user          User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  participation EventParticipation @relation(fields: [participationId], references: [id], onDelete: Cascade)

  @@index([eventId, userId])
  @@index([bossId])
  @@index([createdAt])
  @@map("event_raid_attempts")
}

// รางวัล Milestone ทั้ง personal และ community (GDD §13.6–13.7)
model EventMilestone {
  id           String              @id @default(cuid())
  eventId      String              @map("event_id")
  scope        EventMilestoneScope
  tier         Int
  threshold    Int
  title        String
  titleTh      String              @map("title_th")
  rewardType   EventRewardType     @map("reward_type")
  rewardAmount Int                 @default(0) @map("reward_amount")
  rewardLabel  String?             @map("reward_label")
  createdAt    DateTime            @default(now())

  // Relations
  event Event @relation(fields: [eventId], references: [id], onDelete: Cascade)

  @@unique([eventId, scope, tier])
  @@index([eventId])
  @@map("event_milestones")
}

enum EventMilestoneScope {
  PERSONAL
  COMMUNITY
}

enum EventRewardType {
  COIN
  VEIL_SHARDS
  CRAFTING_DUST
  CARD
  COSMETIC
  TITLE
  STORY_CHAPTER
}

// ของใน Event Shop (ซื้อด้วย Veil Shards)
model EventShopItem {
  id            String          @id @default(cuid())
  eventId       String          @map("event_id")
  code          String
  name          String
  nameTh        String          @map("name_th")
  descriptionTh String?         @map("description_th")
  price         Int
  rewardType    EventRewardType @map("reward_type")
  rewardAmount  Int             @default(0) @map("reward_amount")
  perUserLimit  Int             @default(0) @map("per_user_limit")
  isActive      Boolean         @default(true) @map("is_active")
  createdAt     DateTime        @default(now())

  // Relations
  event     Event               @relation(fields: [eventId], references: [id], onDelete: Cascade)
  purchases EventShopPurchase[]

  @@unique([eventId, code])
  @@index([eventId])
  @@map("event_shop_items")
}

model EventShopPurchase {
  id             String   @id @default(cuid())
  eventId        String   @map("event_id")
  itemId         String   @map("item_id")
  userId         String   @map("user_id")
  idempotencyKey String?  @unique @map("idempotency_key")
  pricePaid      Int      @map("price_paid")
  createdAt      DateTime @default(now())

  // Relations
  item  EventShopItem @relation(fields: [itemId], references: [id], onDelete: Cascade)
  event Event         @relation(fields: [eventId], references: [id], onDelete: Cascade)
  user  User          @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([eventId, userId])
  @@index([itemId])
  @@map("event_shop_purchases")
}

// เนื้อเรื่องที่ปลดล็อกตาม Community Damage
model EventStoryChapter {
  id             String   @id @default(cuid())
  eventId        String   @map("event_id")
  chapterNo      Int      @map("chapter_no")
  title          String
  titleTh        String   @map("title_th")
  bodyTh         String   @map("body_th")
  unlockAtDamage Int      @default(0) @map("unlock_at_damage")
  createdAt      DateTime @default(now())

  // Relations
  event Event @relation(fields: [eventId], references: [id], onDelete: Cascade)

  @@unique([eventId, chapterNo])
  @@index([eventId])
  @@map("event_story_chapters")
}

// สถิติรวมระดับ event (community progress) — 1 แถวต่อ 1 event
model EventCommunityProgress {
  id               String   @id @default(cuid())
  eventId          String   @unique @map("event_id")
  totalDamage      Int      @default(0) @map("total_damage")
  totalPoints      Int      @default(0) @map("total_points")
  participantCount Int      @default(0) @map("participant_count")
  raidCount        Int      @default(0) @map("raid_count")
  updatedAt        DateTime @updatedAt

  // Relations
  event Event @relation(fields: [eventId], references: [id], onDelete: Cascade)

  @@map("event_community_progress")
}

// ===== PHASE 11.3: ของสะสมผู้เล่น (ปลายทางของรางวัล cosmetic / crafting) =====

// ของสะสมของผู้เล่น (การ์ดพิเศษ, เครื่องประดับ, ฉายา, วัตถุดิบ, บทเนื้อเรื่อง)
model UserInventoryItem {
  id         String            @id @default(cuid())
  userId     String            @map("user_id")
  itemType   InventoryItemType @map("item_type")
  code       String
  nameTh     String            @map("name_th")
  quantity   Int               @default(1)
  source     String?
  eventId    String?           @map("event_id")
  metadata   Json?
  acquiredAt DateTime          @default(now()) @map("acquired_at")
  updatedAt  DateTime          @updatedAt

  // Relations
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, itemType, code])
  @@index([userId, itemType])
  @@map("user_inventory_items")
}

enum InventoryItemType {
  CARD
  COSMETIC
  TITLE
  CRAFTING_DUST
  STORY_CHAPTER
}

// ===== NOTIFICATIONS (Phase 20) =====
//
// ผู้ใช้สั่ง 2026-09-26: "ทำระบบแจ้งเตือนต่างๆ เช่นทำรูปเสร็จ, ต่อสู้จบ รายงานผล
// หรือประกาศต่างๆ สำหรับของแต่ละ User"
//
// เก็บข้อความสองภาษาในแถวเดียว (titleTh/titleEn) แล้วให้ API เลือกภาษาตาม User.locale
// → ผู้เล่นสลับภาษาภายในเกมได้ โดยไม่ต้องสร้างข้อความใหม่
model Notification {
  id        String           @id @default(cuid())
  userId    String           @map("user_id")
  type      NotificationType
  titleTh   String           @map("title_th")
  titleEn   String           @map("title_en")
  bodyTh    String           @map("body_th")
  bodyEn    String           @map("body_en")
  // ลิงก์ให้กดไปดูต่อ (เช่น /cards/<id> เพื่อดูภาพการ์ดที่สร้างเสร็จ)
  href      String?
  icon      String?
  isRead    Boolean          @default(false) @map("is_read")
  readAt    DateTime?        @map("read_at")
  metadata  Json?
  createdAt DateTime         @default(now()) @map("created_at")

  // Relations
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
  @@index([userId, isRead])
  @@map("notifications")
}

enum NotificationType {
  IMAGE_READY
  IMAGE_FAILED
  BATTLE_RESULT
  ARENA_RESULT
  EVENT
  ANNOUNCEMENT
  SYSTEM
}

// ประกาศจากทีมงาน — สร้างแล้ว fan-out เป็น Notification ให้ผู้เล่นทุกคน (ต่อ user)
model Announcement {
  id          String   @id @default(cuid())
  titleTh     String   @map("title_th")
  titleEn     String   @map("title_en")
  bodyTh      String   @map("body_th")
  bodyEn      String   @map("body_en")
  href        String?
  isActive    Boolean  @default(true) @map("is_active")
  recipients  Int      @default(0)
  createdBy   String?  @map("created_by")
  publishedAt DateTime @default(now()) @map("published_at")

  @@index([isActive, publishedAt])
  @@map("announcements")
}

// ===== PHASE 25: ITEM + ช่องใส่ 3 ช่อง (โจมตี/ป้องกัน/สนับสนุน) + Veil Shards =====
//
// ผู้ใช้สั่ง 2026-09-27: "ได้จากการขายการ์ดคืนร้าน จำนวนขึ้นกับความหายากของการ์ด บางส่วนก็ได้จากกิจกรรม
//   ทำในส่วนของช่างใส่ Item เพิ่ม Status ให้ 3 ช่อง Item โจมตี, ป้องกัน, สนับสนุน
//   สำหรับใส่ Item ที่ได้รับ หรือ Craft มาได้"

/// ช่องใส่ Item ของการ์ด — 3 ช่องตายตัว (โจมตี / ป้องกัน / สนับสนุน)
enum ItemSlot {
  ATTACK
  DEFENSE
  SUPPORT
}

/// แคตตาล็อก Item — ข้อมูลตั้งต้นอยู่ใน src/lib/item-definitions.ts และ upsert อัตโนมัติ (ensureCatalog)
model ItemDefinition {
  id            String   @id @default(cuid())
  code          String   @unique
  name          String
  nameTh        String   @map("name_th")
  descriptionTh String?  @map("description_th")
  slot          ItemSlot
  rarity        Rarity
  atk           Int      @default(0)
  def           Int      @default(0)
  hp            Int      @default(0)
  spd           Int      @default(0)
  icon          String   @default("🗡️")
  /// ราคาคราฟต์ (Veil Shards + ฝุ่นเวท) — 0 = ไม่ใช้ช่องทางนั้น
  craftCost     Int      @default(0) @map("craft_cost")
  dustCost      Int      @default(0) @map("dust_cost")
  /// ราคาซื้อตรงด้วย Veil Shards (null = มีแต่ทางคราฟต์)
  buyCost       Int?     @map("buy_cost")
  isActive      Boolean  @default(true) @map("is_active")
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  userItems  UserItem[]
  equippedBy CardItemSlot[]

  @@index([slot])
  @@index([rarity])
  @@map("item_definitions")
}

/// Item ที่ผู้เล่นถืออยู่ (1 แถว = 1 ชนิด · quantity = จำนวนชิ้น)
model UserItem {
  id              String   @id @default(cuid())
  userId          String   @map("user_id")
  itemId          String   @map("item_id")
  quantity        Int      @default(1)
  firstAcquiredAt DateTime @default(now()) @map("first_acquired_at")
  updatedAt       DateTime @updatedAt

  user User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  item ItemDefinition @relation(fields: [itemId], references: [id], onDelete: Cascade)

  @@unique([userId, itemId])
  @@index([userId])
  @@map("user_items")
}

/// ช่องใส่ Item ของการ์ด (สูงสุด 1 ชิ้นต่อช่องต่อการ์ด)
model CardItemSlot {
  id         String   @id @default(cuid())
  userCardId String   @map("user_card_id")
  slot       ItemSlot
  itemId     String   @map("item_id")
  equippedAt DateTime @default(now()) @map("equipped_at")
  updatedAt  DateTime @updatedAt

  userCard UserCard       @relation(fields: [userCardId], references: [id], onDelete: Cascade)
  item     ItemDefinition @relation(fields: [itemId], references: [id], onDelete: Cascade)

  @@unique([userCardId, slot])
  @@index([itemId])
  @@map("card_item_slots")
}

/// ประวัติได้/ใช้ Veil Shards (รูปแบบเดียวกับ WalletTransaction ของ Coin)
model VeilShardTransaction {
  id             String          @id @default(cuid())
  userId         String          @map("user_id")
  amount         Int
  type           TransactionType
  source         String
  description    String?
  balanceBefore  Int             @map("balance_before")
  balanceAfter   Int             @map("balance_after")
  idempotencyKey String?         @unique @map("idempotency_key")
  createdAt      DateTime        @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
  @@map("veil_shard_transactions")
}

// ===== PHASE 31: DUNGEON — ดันเจี้ยนหาวัตถุดิบคราฟต์ =====
//
// ผู้ใช้สั่ง 2026-09-27: ดันฟรีตลอด/ฟรีตามเวลา/ใช้เหรียญ · หลายชั้นยากขึ้นเรื่อยๆ
// ทีมศัตรูพิเศษ (บอส 1 + ลูกน้อง, 5-8 ใบ) — status อยู่ในโค้ด (dungeon-definitions.ts)
// ไม่ผูก CardDefinition จึงไม่ต้อง Gen รูปเพิ่ม (reuse art ตาม artRefs)

/// ความคืบหน้าต่อผู้เล่นต่อดัน (ชั้นสูงสุดที่เคยชนะ — ใช้ปลดล็อกชั้นถัดไป)
model DungeonProgress {
  id          String   @id @default(cuid())
  userId      String   @map("user_id")
  dungeonCode String   @map("dungeon_code")
  bestFloor   Int      @default(0) @map("best_floor")
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, dungeonCode])
  @@index([userId])
  @@map("dungeon_progress")
}

/// ประวัติการลุย 1 ครั้ง (idempotent ด้วย runId)
model DungeonRun {
  id               String   @id @default(cuid())
  runId            String   @unique @map("run_id")
  userId           String   @map("user_id")
  dungeonCode      String   @map("dungeon_code")
  floor            Int
  deckId           String   @map("deck_id")
  won              Boolean  @default(false)
  roundsPlayed     Int      @default(0) @map("rounds_played")
  teamHpRemaining  Int      @default(0) @map("team_hp_remaining")
  enemyHpRemaining Int      @default(0) @map("enemy_hp_remaining")
  dustEarned       Int      @default(0) @map("dust_earned")
  shardsEarned     Int      @default(0) @map("shards_earned")
  itemDropped      String?  @map("item_dropped")
  itemNameTh       String?  @map("item_name_th")
  coinsSpent       Int      @default(0) @map("coins_spent")
  battleData       Json?    @map("battle_data")
  createdAt        DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, dungeonCode])
  @@index([createdAt])
  @@map("dungeon_runs")
}
