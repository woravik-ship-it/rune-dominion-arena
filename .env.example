# Database
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/rune_dominion?schema=public"

# Redis
REDIS_URL="redis://localhost:6379"

# Auth
AUTH_SECRET="your-secret-key-here-change-in-production"

# Server
SERVER_PEPPER="your-server-pepper-here-change-in-production"

# AI Image Generation (Optional)
AI_IMAGE_API_KEY=""
AI_IMAGE_API_URL=""

# Worker (Optional) — token สำหรับ cron เรียก /api/admin/images/*
WORKER_TOKEN=""

# Security (Phase 10)
# CORS — origin เพิ่มเติมที่อนุญาต (คั่น comma) — ค่าเริ่มต้น same-origin เท่านั้น
CORS_ALLOWED_ORIGINS=""
# Rate limit override (ตัวอย่าง) — รูปแบบ RATE_LIMIT_<SCOPE>_LIMIT
# RATE_LIMIT_API_BURST_LIMIT=120
# RATE_LIMIT_DISCOVER_LIMIT=30
# RATE_LIMIT_AUTH_LOGIN_LIMIT=10

# App
NEXT_PUBLIC_APP_URL="http://localhost:3000"
NODE_ENV="development"
