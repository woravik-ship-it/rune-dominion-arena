# Database
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/rune_dominion?schema=public"

# Redis
REDIS_URL="redis://localhost:6379"

# Auth
AUTH_SECRET="your-secret-key-here-change-in-production"

# Server
SERVER_PEPPER="your-server-pepper-here-change-in-production"

# AI Image Generation (Phase 14 — ค่าเริ่มต้นใช้ pollinations ที่ไม่ต้องมี key)
# provider: pollinations (GET, ฟรี) หรือ generic (POST JSON + Bearer key คืน { url })
AI_IMAGE_PROVIDER="pollinations"
AI_IMAGE_API_URL="https://image.pollinations.ai/prompt"
AI_IMAGE_MODEL="flux"
AI_IMAGE_API_KEY=""
# ตั้งเป็น 1 เมื่อต้องการปิด AI แล้วกลับไปใช้การ์ดวาดเอง (deterministic SVG)
AI_IMAGE_DISABLED=""

# Worker (Optional) — token สำหรับ cron เรียก /api/admin/images/*
WORKER_TOKEN=""

# Security (Phase 10)
# CORS — origin เพิ่มเติมที่อนุญาต (คั่น comma) — ค่าเริ่มต้น same-origin เท่านั้น
CORS_ALLOWED_ORIGINS=""
# Rate limit override (ตัวอย่าง) — รูปแบบ RATE_LIMIT_<SCOPE>_LIMIT
# RATE_LIMIT_API_BURST_LIMIT=120
# RATE_LIMIT_DISCOVER_LIMIT=30
# RATE_LIMIT_AUTH_LOGIN_LIMIT=10

# App
NEXT_PUBLIC_APP_URL="http://localhost:3000"
NODE_ENV="development"
