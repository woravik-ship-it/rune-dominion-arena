# Database
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/rune_dominion?schema=public"

# Redis
REDIS_URL="redis://localhost:6379"

# Auth
AUTH_SECRET="your-secret-key-here-change-in-production"

# Server
SERVER_PEPPER="your-server-pepper-here-change-in-production"

# AI Image Generation (Phase 14 — ค่าเริ่มต้นใช้ pollinations ที่ไม่ต้องมี key)
# provider: pollinations (GET, ฟรี) หรือ generic (POST JSON + Bearer key)
AI_IMAGE_PROVIDER="pollinations"
AI_IMAGE_API_URL="https://image.pollinations.ai/prompt"
AI_IMAGE_MODEL="sana"
AI_IMAGE_API_KEY=""
# --- OpenAI (ตัวอย่าง: ตั้งแบบประหยัด — การ์ดทั่วไปใช้ถูกสุด · EPIC ขึ้นไปสูงขึ้นนิดหน่อย) ---
# AI_IMAGE_PROVIDER="generic"
# AI_IMAGE_API_URL="https://api.openai.com/v1/images/generations"
# AI_IMAGE_MODEL="gpt-image-1-mini"          # การ์ดทั่วไป (COMMON/UNCOMMON/RARE)
# AI_IMAGE_QUALITY="low"                     # low = ถูกสุด (400 image tokens @1536x1024)
# AI_IMAGE_PREMIUM_MODEL="gpt-image-1-mini"  # EPIC ขึ้นไป
# AI_IMAGE_PREMIUM_QUALITY="medium"          # สูงขึ้นนิดหน่อย (1,568 image tokens)
# AI_IMAGE_PREMIUM_RARITIES="EPIC,LEGENDARY,MYTHIC"
# AI_IMAGE_API_KEY="sk-..."
# AI_IMAGE_SIZE="1536x1024"             # แนวนอนเข้ากับช่องภาพการ์ด
# AI_IMAGE_OUTPUT_FORMAT="jpeg"          # png | jpeg | webp
# AI_IMAGE_COMPRESSION="85"              # ใช้กับ jpeg/webp
# ตั้งเป็น 1 เมื่อต้องการปิด AI แล้วกลับไปใช้การ์ดวาดเอง
AI_IMAGE_DISABLED=""

# Worker (Optional) — token สำหรับ cron เรียก /api/admin/images/*
WORKER_TOKEN=""

# Security (Phase 10)
# CORS — origin เพิ่มเติมที่อนุญาต (คั่น comma) — ค่าเริ่มต้น same-origin เท่านั้น
CORS_ALLOWED_ORIGINS=""
# Rate limit override (ตัวอย่าง) — รูปแบบ RATE_LIMIT_<SCOPE>_LIMIT
# RATE_LIMIT_API_BURST_LIMIT=120
# RATE_LIMIT_DISCOVER_LIMIT=30
# RATE_LIMIT_AUTH_LOGIN_LIMIT=10

# App
NEXT_PUBLIC_APP_URL="http://localhost:3000"
NODE_ENV="development"
